{
  "name": "fileroute",
  "version": "1.0.0",
  "description": "fileroute — Route files to the right place automatically. Monitor folders, match conditions, run actions. A powerful IF→THEN file automation CLI for Windows, macOS, and Linux.",
  "main": "index.js",
  "type": "commonjs",
  "preferGlobal": true,
  "files": [
    "index.js",
    "src",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "fileroute": "./index.js",
    "route": "./index.js"
  },
  "scripts": {
    "test": "npm run test:smoke",
    "start": "node index.js",
    "help": "node index.js --help",
    "test:smoke": "node index.js --help && node index.js preview --dry-run && node index.js undo --help",
    "prepublishOnly": "npm run test:smoke",
    "release": "npm version patch -m \"release: %s\" && git push origin main --follow-tags",
    "run": "node index.js run",
    "setup": "node index.js setup",
    "organize": "node index.js run",
    "clean": "node index.js run",
    "preview": "node index.js preview",
    "undo": "node index.js undo",
    "watch": "node index.js watch",
    "config": "node index.js config",
    "rules": "node index.js rules"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "inquirer": "^8.2.5",
    "cli-progress": "^3.12.0",
    "chokidar": "^3.5.3"
  },
  "keywords": [
    "fileroute",
    "file-router",
    "cli",
    "file-organizer",
    "file-automation",
    "downloads-cleaner",
    "folder-organizer",
    "desktop-cleaner",
    "automation",
    "filesystem",
    "productivity",
    "nodejs",
    "undo",
    "file-management",
    "file-watcher",
    "rule-engine",
    "if-then",
    "watch-folder",
    "sort-files",
    "organize-files"
  ],
  "author": "kirtan kalathiya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirtan-kalathiya/fileroute.git"
  },
  "homepage": "https://fileroute.dev/",
  "bugs": {
    "url": "https://github.com/kirtan-kalathiya/fileroute/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16"
  }
}
